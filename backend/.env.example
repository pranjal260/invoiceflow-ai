# Database
DB_URL=jdbc:postgresql://localhost:5432/invoiceflow
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Application security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Private document storage (Backblaze B2 / S3-compatible)
B2_ENDPOINT=https://s3.example.com
B2_REGION=us-east-005
B2_BUCKET=invoiceflow-files
B2_ACCESS_KEY_ID=replace-me
B2_SECRET_ACCESS_KEY=replace-me
STORAGE_PRESIGNED_URL_EXPIRATION=15

# AI extraction
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
